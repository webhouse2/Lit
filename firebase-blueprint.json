        "isPremium": { "type": "boolean" },
        "tokenPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "published", "rejected", "suspended", "removed"] },
        "copyrightConfirmed": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "chaptersCount": { "type": "number" },
        "readsCount": { "type": "number" },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "title", "authorId", "authorName", "coverUrl", "description", "genre", "category", "tags", "language", "ageRating", "isPremium", "tokenPrice", "status", "copyrightConfirmed", "featured", "trending", "chaptersCount", "readsCount", "ratingAvg", "ratingCount", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Individual chapter record belonging to a book",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
