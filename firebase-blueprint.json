        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "penName", "bio", "location", "status", "copyrightAgreed", "followersCount", "totalReads", "averageRating", "createdAt", "updatedAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Structured literary book record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
